menu "HMAC algorithms"

config CRYPTO_HMAC_SHA1
	bool

config CRYPTO_HMAC_SHA2
	bool

config CRYPTO_HMAC_SHA3
	bool

choice
	prompt "HMAC-SHA-1 support"
	depends on !MODULES
	default CRYPTO_HMAC_SHA1_SEL_Y
	help
	  Enable or disable HMAC-SHA-1-160.

config CRYPTO_HMAC_SHA1_SEL_N
	bool "None"
	help
	  Do not include HMAC-SHA-1 support.

config CRYPTO_HMAC_SHA1_SEL_Y
	bool "HMAC-SHA-1"
	depends on !MODULES
	select CRYPTO_HMAC_SHA1
	help
	  HMAC-SHA-1-160 keyed-hash message authentication code.

endchoice

comment "HMAC-SHA-1 module (Y=built-in, M=module, N=disabled)"
	depends on MODULES

config CRYPTO_HMAC_SHA1_DYN
	tristate "HMAC-SHA-1"
	depends on MODULES
	default m
	help
	  HMAC-SHA-1-160 keyed-hash message authentication code.

choice
	prompt "HMAC-SHA-2 support"
	depends on !MODULES
	default CRYPTO_HMAC_SHA2_SEL_Y
	help
	  Enable or disable HMAC-SHA-224/256/384/512.

config CRYPTO_HMAC_SHA2_SEL_N
	bool "None"
	help
	  Do not include HMAC-SHA-2 support.

config CRYPTO_HMAC_SHA2_SEL_Y
	bool "HMAC-SHA-2"
	depends on !MODULES
	select CRYPTO_HMAC_SHA2
	help
	  HMAC-SHA-224/256/384/512 keyed-hash message authentication code.

endchoice

comment "HMAC-SHA-2 module (Y=built-in, M=module, N=disabled)"
	depends on MODULES

config CRYPTO_HMAC_SHA2_DYN
	tristate "HMAC-SHA-2"
	depends on MODULES
	default m
	help
	  HMAC-SHA-224/256/384/512 keyed-hash message authentication code.

choice
	prompt "HMAC-SHA-3 support"
	depends on !MODULES
	default CRYPTO_HMAC_SHA3_SEL_Y
	help
	  Enable or disable HMAC-SHA-3-224/256/384/512.

config CRYPTO_HMAC_SHA3_SEL_N
	bool "None"
	help
	  Do not include HMAC-SHA-3 support.

config CRYPTO_HMAC_SHA3_SEL_Y
	bool "HMAC-SHA-3"
	depends on !MODULES
	select CRYPTO_HMAC_SHA3
	help
	  HMAC-SHA-3-224/256/384/512 keyed-hash message authentication code.

endchoice

comment "HMAC-SHA-3 module (Y=built-in, M=module, N=disabled)"
	depends on MODULES

config CRYPTO_HMAC_SHA3_DYN
	tristate "HMAC-SHA-3"
	depends on MODULES
	default m
	help
	  HMAC-SHA-3-224/256/384/512 keyed-hash message authentication code.

#
# HMAC-MD5. The one MD5 composition that is not broken by MD5's collisions,
# and the reason a TLS 1.0/1.1 build has the digest at all: the *_WITH_*_MD5
# suites authenticate a record with this. Off by default, with the digest.
#

config CRYPTO_HMAC_MD5
	bool "HMAC-MD5 (for TLS 1.0/1.1 only)"
	depends on !MODULES
	default n
	select CRYPTO_MD5
	help
	  HMAC-MD5 keyed-hash message authentication code (RFC 2104), for the
	  record MAC of the TLS suites whose name ends in _MD5 and for nothing
	  else. Selects CRYPTO_MD5, which it is built on.

	  If unsure, say N.

comment "HMAC-MD5 module (Y=built-in, M=module, N=disabled)"
	depends on MODULES

config CRYPTO_HMAC_MD5_DYN
	tristate "HMAC-MD5 (for TLS 1.0/1.1 only)"
	depends on MODULES
	default n
	help
	  HMAC-MD5 as a loadable module. See CRYPTO_HMAC_MD5.

	  Needs CRYPTO_MD5_DYN, and does not select it: a select on a tristate
	  forces it to y, and =y on a DYN symbol is the one shape these
	  backends do not have — the module glue compiled into the tree beside
	  the built-in.h that already inlined the same bodies.
	  configs/insecure.config asks for both.

endmenu

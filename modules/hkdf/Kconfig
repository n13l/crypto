#
# HKDF-SM3. The key derivation of the ShangMi TLS 1.3 suites (RFC 8998 sec 3).
# Off by default, with the digest. The TLS record layer in un builds its
# HKDF-Expand from HMAC-SM3 directly (modules/net/tls/hs/tls13.h), the way it
# does for SHA-2, so what this module adds is the registry entry and the
# free-function API for anything else that wants the whole construction.
#

config CRYPTO_HKDF_SM3
	bool "HKDF-SM3 (for the ShangMi TLS 1.3 suites)"
	depends on !MODULES
	default n
	select CRYPTO_SM3
	help
	  HKDF-SM3 HMAC-based key derivation function (RFC 5869 over
	  GB/T 32905), the KDF of TLS_SM4_GCM_SM3 and TLS_SM4_CCM_SM3
	  (RFC 8998). Selects CRYPTO_SM3, which it is built on.

	  If unsure, say N.

comment "HKDF-SM3 module (Y=built-in, M=module, N=disabled)"
	depends on MODULES

config CRYPTO_HKDF_SM3_DYN
	tristate "HKDF-SM3 (for the ShangMi TLS 1.3 suites)"
	depends on MODULES
	default n
	help
	  HKDF-SM3 as a loadable module. See CRYPTO_HKDF_SM3. Needs
	  CRYPTO_SM3_DYN; configs/sm.config asks for both.

endmenu

obj-$(CONFIG_CRYPTO_SHA3_OSSL_ARMV8) += keccakf1600.o keccak1600-armv8.o
obj-$(CONFIG_CRYPTO_SHA3_DYN_OSSL_ARMV8) += sha3-ossl-armv8.o
sha3-ossl-armv8-objs := keccakf1600.o module.o keccak1600-armv8.o

OSSL_SHA_ASM := $(objtree)/vendor/openssl/crypto/sha

AFLAGS_keccak1600-armv8.o := -I$(srctree)/vendor/openssl/include
$(OSSL_SHA_ASM)/keccak1600-armv8.S: $(srctree)/vendor/openssl/crypto/sha/asm/keccak1600-armv8.pl
	@mkdir -p $(dir $@)
	$(PERL) $< linux64 $@
$(obj)/keccak1600-armv8.o: $(OSSL_SHA_ASM)/keccak1600-armv8.S
	$(call cmd,as_o_S)

#
# The block glue, one object, and only where the object is wanted.
#
# The glue is written once for the whole family and compiled against this
# backend: modules/digest/sha3-arch/arch.c is the include of built-in.h and
# nothing else, and the -I below is what makes that this backend's built-in.h
# (the same arrangement as modules/cipher/aes-ccm/ccm.c, a mode written once and
# compiled against each backend's block cipher).
#
# Optimizing for size that is where the glue is compiled and every caller of a
# digest calls across the boundary; optimizing for speed built-in.h carries the
# bodies into each caller, this object would hold nothing, and it is not built.
# modules/digest/sha3-arch/decl.h says the rest of it.
#
SHA3_ARCH := $(srctree)/$(CRYPTO_DIR)/modules/digest/sha3-arch

ifdef CONFIG_CC_OPTIMIZE_FOR_SIZE
obj-$(CONFIG_CRYPTO_SHA3_OSSL_ARMV8) += arch.o
$(obj)/arch.o: $(SHA3_ARCH)/arch.c FORCE
	$(call if_changed_rule,cc_o_c)
CFLAGS_arch.o := -I$(srctree)/$(CRYPTO_DIR)/modules/digest/sha3-ossl-armv8
endif

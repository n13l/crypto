obj-$(CONFIG_CRYPTO_SHA2_OSSL_X86_64) += sha256_block.o sha512_block.o sha256-x86_64.o sha512-x86_64.o ossl_x86cap.o
obj-$(CONFIG_CRYPTO_SHA2_DYN_OSSL_X86_64) += sha2-ossl-x86_64.o
sha2-ossl-x86_64-objs := sha256_block.o sha512_block.o sha256-x86_64.o sha512-x86_64.o ossl_x86cap.o

OSSL_SHA_ASM := $(objtree)/vendor/openssl/crypto/sha

$(OSSL_SHA_ASM)/sha256-x86_64.s: $(srctree)/vendor/openssl/crypto/sha/asm/sha512-x86_64.pl
	@mkdir -p $(dir $@)
	$(PERL) $< elf $@
$(OSSL_SHA_ASM)/sha512-x86_64.s: $(srctree)/vendor/openssl/crypto/sha/asm/sha512-x86_64.pl
	@mkdir -p $(dir $@)
	$(PERL) $< elf $@
$(obj)/sha256-x86_64.o: $(OSSL_SHA_ASM)/sha256-x86_64.s
	$(call cmd,ossl_as_o_S)
$(obj)/sha512-x86_64.o: $(OSSL_SHA_ASM)/sha512-x86_64.s
	$(call cmd,ossl_as_o_S)
$(obj)/ossl_x86cap.o: $(srctree)/$(CRYPTO_DIR)/modules/cpu/x86-ossl/cap.c
	$(call cmd,cc_o_c)

CFLAGS_sha256_block.o := \
	-I$(srctree)/$(CRYPTO_DIR)/modules/digest/sha2-ossl-x86_64 \
	-I$(srctree)/vendor/openssl/include \
	-I$(srctree)/vendor/openssl \
	-I$(objtree)/vendor/openssl/include \
	-DSHA256_ASM

CFLAGS_sha512_block.o := \
	-I$(srctree)/$(CRYPTO_DIR)/modules/digest/sha2-ossl-x86_64 \
	-I$(srctree)/vendor/openssl/include \
	-I$(srctree)/vendor/openssl \
	-I$(objtree)/vendor/openssl/include \
	-DSHA512_ASM

#
# The block glue, one object, and only where the object is wanted.
#
# The glue is written once for the whole family and compiled against this
# backend: modules/digest/sha2-arch/arch.c is the include of built-in.h and
# nothing else, and the -I below is what makes that this backend's built-in.h
# (the same arrangement as modules/cipher/aes-ccm/ccm.c, a mode written once and
# compiled against each backend's block cipher).
#
# Optimizing for size that is where the glue is compiled and every caller of a
# digest calls across the boundary; optimizing for speed built-in.h carries the
# bodies into each caller, this object would hold nothing, and it is not built.
# modules/digest/sha2-arch/decl.h says the rest of it.
#
SHA2_ARCH := $(srctree)/$(CRYPTO_DIR)/modules/digest/sha2-arch

ifdef CONFIG_CC_OPTIMIZE_FOR_SIZE
obj-$(CONFIG_CRYPTO_SHA2_OSSL_X86_64) += arch.o
$(obj)/arch.o: $(SHA2_ARCH)/arch.c FORCE
	$(call if_changed_rule,cc_o_c)
CFLAGS_arch.o := -I$(srctree)/$(CRYPTO_DIR)/modules/digest/sha2-ossl-x86_64
endif
